{
    "manifest_version": 3,
    "name": "Auto Refresher",
    "version": "1.0.0",
    "description": "Reload the current website on a custom timer.",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_title": "Auto Refresher",
        "default_popup": "popup.html"
    }
}